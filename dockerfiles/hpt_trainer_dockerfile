FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC

RUN set -eu && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list \
      && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
      && apt-get update && apt-get install -y google-cloud-sdk \
      && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
      kfp==2.6.0 \
      google-cloud-pipeline-components==2.13.0 \
      google-cloud-aiplatform==1.64.0 \
      "protobuf>=4.25,<5" "kubernetes<27" \
      fastapi \
      uvicorn && \
    pip check
  
WORKDIR /app
COPY hpt_and_train.py .
COPY pipeline_submission.py .
RUN chmod +x pipeline_submission.py

#ENTRYPOINT ["python","./hpt_and_train.py"]
CMD ["uvicorn", "pipeline_submission:app", "--host", "0.0.0.0", "--port", "8080"]
